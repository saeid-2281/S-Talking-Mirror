{
  "version": 1,
  "name": "Test",
  "csv_path": "sample/input.csv",
  "output_path": "output",
  "settings": {
    "provider": "elevenlabs",
    "api_key": "",
    "voice_id": "",
    "model_id": "eleven_multilingual_v2",
    "language_code": "da",
    "output_format": "mp3_44100_128",
    "file_extension": ".mp3",
    "stability": 0.45,
    "similarity_boost": 0.75,
    "style": 0.2,
    "use_speaker_boost": true,
    "speed": 1.0,
    "delay_seconds": 0.5,
    "timeout_seconds": 90.0,
    "max_retries": 4,
    "skip_existing": true,
    "overwrite_existing": false,
    "piper_model_path": null
  }
}